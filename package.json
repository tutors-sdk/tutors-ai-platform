{
  "name": "tutors-ai-platform",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "lint:suite-health": "node scripts/check-suite-health.ts",
    "lint:determinism": "node scripts/check-determinism.ts",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "ears": "node scripts/check-ears.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:properties": "FC_NUM_RUNS=10000 vitest run --project unit --testTimeout=600000 property",
    "test:soak": "vitest run --project soak",
    "mutation": "pnpm --workspace-concurrency=1 --filter @tutors-ai/core --filter @tutors-ai/adapter-resilience --filter @tutors-ai/adapter-ollama run mutation",
    "mutation:fixture": "cd scripts/mutation-fixture && stryker run && node ../check-mutation.mjs --fixture",
    "ratchets": "node scripts/check-ratchets.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:suite-health && pnpm lint:determinism && pnpm ears && pnpm test --project unit",
    "eval": "pnpm --filter @tutors-ai/evaluation -s eval"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.4"
  }
}
