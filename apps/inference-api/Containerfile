# Build from the repository root:
#   podman build -f apps/inference-api/Containerfile -t quay.io/tutors-sdk/inference-api .
FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS build
USER 0
WORKDIR /src
RUN npm install -g pnpm@10
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @tutors-ai/app-inference-api build

FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:latest
WORKDIR /opt/app
COPY --from=build /src/apps/inference-api/dist/main.mjs ./main.mjs
COPY --from=build /src/LICENSE* ./
ENV NODE_ENV=production \
    PORT=8080 \
    COURSE_EXPORT_DIR=/data/courses
EXPOSE 8080
# Runs as the image's non-root user; OpenShift assigns an arbitrary UID, which needs no write access here.
USER 1001
CMD ["node", "/opt/app/main.mjs"]
